---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { withBase } from '../lib/url';
import { SITE } from '../consts';

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <section class="kh-hero section">
    <div class="kh-meta-row">
      <span>CHICAGO, IL</span>
      <span>MEDIA / TECHNOLOGY / PRODUCT</span>
      <span>2026</span>
    </div>
    <h1 class="kh-name"><span>KIAH</span><span>HARPOOL</span></h1>
    <div class="kh-hero-bottom">
      <p class="kh-deck">Media leader, builder, and product-minded problem solver.</p>
      <p class="kh-side-note">I notice friction.<br />Then I make something better.</p>
    </div>
  </section>

  <section class="kh-intro section">
    <p class="kh-kicker">01 / ABOUT THE WORK</p>
    <h2>I make things work better.</h2>
    <p class="kh-intro-copy">
      I work where media, technology, systems, and culture overlap — turning messy processes,
      interesting ideas, and small frustrations into clearer tools and better experiences.
    </p>
  </section>

  <section class="kh-work section" aria-labelledby="selected-work">
    <div class="kh-section-head">
      <p class="kh-kicker">02 / SELECTED WORK</p>
      <h2 id="selected-work">Things I thought should exist.</h2>
    </div>

    <article class="kh-project kh-project-lavender">
      <div class="kh-project-index">01</div>
      <div class="kh-project-copy">
        <p class="kh-project-meta">PRODUCT / DESIGN / DEVELOPMENT</p>
        <h3>DUEL CUT</h3>
        <p>A movie-ranking app built around head-to-head choices and a taste profile that gets smarter as you rank.</p>
        <div class="kh-project-links">
          <a class="button" href="https://github.com/iphiginea/duelcut" target="_blank" rel="noopener noreferrer">View GitHub ↗</a>
        </div>
      </div>
      <div class="kh-project-mark">DC</div>
    </article>

    <article class="kh-project kh-project-blush">
      <div class="kh-project-index">02</div>
      <div class="kh-project-copy">
        <p class="kh-project-meta">PRODUCT / MUSIC / PERSONAL DATA</p>
        <h3>ENCORE</h3>
        <p>A concert-ranking project that turns the shows you have seen into a personal canon through head-to-head duels.</p>
        <div class="kh-project-links">
          <a class="button" href="https://github.com/iphiginea/encore" target="_blank" rel="noopener noreferrer">View GitHub ↗</a>
        </div>
      </div>
      <div class="kh-project-mark">EN</div>
    </article>
  </section>

  <section class="kh-recognition section" aria-labelledby="recognition">
    <div class="kh-section-head">
      <p class="kh-kicker">03 / RECOGNITION + LEADERSHIP</p>
      <h2 id="recognition">Selected signals.</h2>
    </div>

    <div class="kh-recognition-grid">
      <article>
        <span class="kh-card-label">TVB</span>
        <h3>Executive NEXT Buyer Honoree</h3>
        <span class="kh-arrow">→</span>
      </article>
      <article>
        <span class="kh-card-label">PMX</span>
        <h3>Investment Credo Award</h3>
        <span class="kh-arrow">→</span>
      </article>
      <article>
        <span class="kh-card-label">MAC</span>
        <h3>President, Media Advertising Club of Chicago</h3>
        <span class="kh-arrow">→</span>
      </article>
      <article>
        <span class="kh-card-label">LEADERSHIP</span>
        <h3>Team management, AI workflows, training & industry programming</h3>
        <span class="kh-arrow">→</span>
      </article>
    </div>
  </section>

  <section class="kh-lab section">
    <p class="kh-kicker">04 / THE LAB</p>
    <div class="kh-lab-grid">
      <h2>Things I’m making because I think they should exist.</h2>
      <div>
        <p>
          Product experiments, AI workflows, ranking systems, media tools, and small ideas that become more interesting once they are real.
        </p>
        <a class="kh-text-link" href={withBase('/works/')}>See the work →</a>
      </div>
    </div>
  </section>

  <section class="kh-contact section">
    <p class="kh-kicker">05 / SAY HELLO</p>
    <h2>Good ideas welcome.</h2>
    <div class="kh-contact-row">
      <a class="button" href="mailto:kiah.harpool@gmail.com">Email me</a>
      <a class="kh-text-link" href="https://github.com/iphiginea" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </section>
</BaseLayout>
