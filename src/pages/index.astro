---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { withBase } from '../lib/url';
import { SITE } from '../consts';

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <section class="kh-hero section">
    <div class="kh-meta-row">
      <span>CHICAGO, IL</span>
      <span>MEDIA / STRATEGY / AI / CULTURE</span>
    </div>

    <h1 class="kh-name"><span>KIAH</span><span>HARPOOL</span></h1>

    <div class="kh-hero-bottom">
      <div class="kh-hero-intro">
        <p class="kh-deck">I make things work better.</p>
        <p class="kh-hero-positioning">
          Media leader working across strategy, investment, AI, and the systems behind better
          decisions.
        </p>
        <a class="kh-pill kh-pill-secondary kh-hero-cta" href="#selected-work">See my work →</a>
      </div>

      <aside class="kh-theme-preview kh-current-card" aria-label="Current focus">
        <div class="kh-theme-preview-head">
          <span>Currently</span>
          <span>→</span>
        </div>
        <p>
          Executing media investment, developing teams, and exploring how to make complicated work
          clearer.
        </p>
        <dl class="kh-current-meta">
          <div>
            <dt>At work</dt>
            <dd>Media strategy / investment / leadership</dd>
          </div>
          <div>
            <dt>Curious about</dt>
            <dd>Bettering workflows / personal experiments</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="kh-work section" aria-labelledby="selected-work">
    <div class="kh-section-head kh-section-head-ui">
      <div>
        <p class="kh-kicker">01 / PERSONAL EXPERIMENTS</p>
        <h2 id="selected-work">Experiments in things I’m curious about.</h2>
      </div>
      <a class="kh-pill" href={withBase('/works/')}>All experiments →</a>
    </div>

    <article class="kh-project kh-project-lavender">
      <div class="kh-project-copy">
        <div class="kh-project-topline">
          <span>01 / DUEL CUT</span>
          <span>PRODUCT / FILM / PERSONAL DATA</span>
        </div>
        <span class="kh-project-role">Personal experiment / Concept + Build</span>
        <h3><a class="kh-project-title-link" href={withBase('/works/duel-cut/')}>DUEL CUT</a></h3>
        <p class="kh-project-deck">
          Your movie taste, directed by choices instead of star ratings.
        </p>
        <p class="kh-project-description">
          I built a head-to-head ranking system that turns repeated choices into a personal movie
          canon, then surfaces rankings and taste patterns from those decisions.
        </p>
        <div class="kh-project-why">
          <strong>Why I made it</strong>
          <p>
            Choosing between two movies I love tells me more than giving both of them four stars. I
            wanted a ranking system that behaves more like taste actually does.
          </p>
        </div>
        <div class="kh-chip-row" aria-label="Duel Cut features">
          <span>DUELS</span>
          <span>RANKINGS</span>
          <span>INSIGHTS</span>
        </div>
        <div class="kh-project-actions">
          <a
            class="kh-pill"
            href="https://iphiginea.github.io/duelcut/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open app ↗
          </a>
          <a
            class="kh-text-link"
            href="https://github.com/iphiginea/duelcut"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <div class="kh-product-visual kh-product-visual-duelcut">
        <figure class="kh-product-shot kh-product-shot-single">
          <a href={withBase('/works/duel-cut/')} aria-label="Read about the Duel Cut experiment">
            <img
              src={withBase('/images/duelcut-duel-hd.webp')}
              alt="Duel Cut interface showing a movie duel between Bugonia and Harold and Maude"
              width="600"
              height="959"
              loading="lazy"
            />
          </a>
        </figure>
      </div>
    </article>

    <article class="kh-project kh-project-blush">
      <div class="kh-project-copy">
        <div class="kh-project-topline">
          <span>02 / ENCORE</span>
          <span>PRODUCT / MUSIC / PERSONAL DATA</span>
        </div>
        <span class="kh-project-role">Personal experiment / Concept + Build</span>
        <h3><a class="kh-project-title-link" href={withBase('/works/encore/')}>ENCORE</a></h3>
        <p class="kh-project-deck">Every concert you have seen. Head to head.</p>
        <p class="kh-project-description">
          I built a concert diary and ranking system around pairwise duels, ticket-like memories,
          ranked shows, and personal statistics.
        </p>
        <div class="kh-project-why">
          <strong>Why I made it</strong>
          <p>
            I kept coming back to an impossible question: what was the best concert I had ever seen?
            Comparing two nights at a time felt more honest than trying to score a lifetime of
            shows.
          </p>
        </div>
        <div class="kh-chip-row" aria-label="Encore features">
          <span>SHOWS</span>
          <span>DUELS</span>
          <span>RANKINGS</span>
        </div>
        <div class="kh-project-actions">
          <a
            class="kh-pill"
            href="https://iphiginea.github.io/encore/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open app ↗
          </a>
          <a
            class="kh-text-link"
            href="https://github.com/iphiginea/encore"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <div class="kh-product-visual kh-product-visual-encore">
        <figure class="kh-product-shot kh-product-shot-primary">
          <a href={withBase('/works/encore/')} aria-label="Read about the Encore experiment">
            <img
              src={withBase('/images/encore-duel-hd.webp')}
              alt="Encore interface showing a concert duel between Joanna Newsom and Kendrick Lamar"
              width="600"
              height="843"
              loading="lazy"
            />
          </a>
        </figure>
        <figure class="kh-product-shot kh-product-shot-secondary">
          <a href={withBase('/works/encore/')} aria-label="Read about the Encore experiment">
            <img
              src={withBase('/images/encore-rankings-hd.webp')}
              alt="Encore rankings interface showing ranked concerts"
              width="600"
              height="1035"
              loading="lazy"
            />
          </a>
        </figure>
      </div>
    </article>

    <div class="kh-more-projects">
      <div class="kh-more-projects-head">
        <p class="kh-kicker">MORE EXPERIMENTS / 2026</p>
        <p>Small ideas I wanted to try for myself.</p>
      </div>

      <div class="kh-project-pair">
        <article class="kh-mini-project kh-mini-project-dueldraw">
          <div class="kh-mini-project-topline">
            <span>03 / DUEL DRAW</span>
            <span>GAME / MULTIPLAYER / DRAWING</span>
          </div>
          <div class="kh-mini-project-body">
            <span class="kh-project-role">Personal experiment / Concept + Build</span>
            <h3>DUEL DRAW</h3>
            <p class="kh-mini-project-deck">Draw it. Clue it. See if they get it.</p>
            <p class="kh-mini-project-description">
              A two-player browser drawing game built around private room codes, alternating turns,
              optional clues, and a shared score.
            </p>
            <p class="kh-mini-project-why">
              <strong>Why:</strong> I wanted a drawing game that felt like playing directly with one person,
              not entering a giant public game room.
            </p>
          </div>
          <div class="kh-mini-project-footer">
            <div class="kh-mini-tags" aria-label="Duel Draw features">
              <span>REAL-TIME</span>
              <span>DRAWING</span>
              <span>GAME DESIGN</span>
            </div>
            <div class="kh-mini-actions">
              <a
                class="kh-pill"
                href="https://iphiginea.github.io/dueldraw/duel-draw.html"
                target="_blank"
                rel="noopener noreferrer">Open app ↗</a
              >
              <a
                class="kh-text-link"
                href="https://github.com/iphiginea/dueldraw"
                target="_blank"
                rel="noopener noreferrer">GitHub ↗</a
              >
            </div>
          </div>
        </article>

        <article class="kh-mini-project kh-mini-project-points">
          <div class="kh-mini-project-topline">
            <span>04 / POINTS</span>
            <span>WELLNESS / GUIDED AUDIO / INTERACTION</span>
          </div>
          <div class="kh-mini-project-body">
            <span class="kh-project-role">Personal experiment / Concept + Build</span>
            <h3>POINTS</h3>
            <p class="kh-mini-project-deck">A guided practice, one point at a time.</p>
            <p class="kh-mini-project-description">
              A body-point-based guided self-hypnosis experience that lets you choose a point,
              select what you are carrying, and move through a focused audio session.
            </p>
            <p class="kh-mini-project-why">
              <strong>Why:</strong> I wanted to explore whether the ritual and focus of acupuncture could
              become a calming at-home experience without needles.
            </p>
          </div>
          <div class="kh-mini-project-footer">
            <div class="kh-mini-tags" aria-label="Points features">
              <span>GUIDED AUDIO</span>
              <span>BODY MAP</span>
              <span>INTERACTION DESIGN</span>
            </div>
            <div class="kh-mini-actions">
              <a
                class="kh-pill"
                href="https://iphiginea.github.io/points/"
                target="_blank"
                rel="noopener noreferrer">Open app ↗</a
              >
              <a
                class="kh-text-link"
                href="https://github.com/iphiginea/points"
                target="_blank"
                rel="noopener noreferrer">GitHub ↗</a
              >
            </div>
          </div>
        </article>
      </div>

      <article class="kh-mini-project kh-mini-project-firstlight">
        <div class="kh-firstlight-copy">
          <div class="kh-mini-project-topline">
            <span>05 / FIRST LIGHT</span>
            <span>PRODUCT / NATURE / LOCATION-AWARE AUDIO</span>
          </div>

          <div class="kh-mini-project-body">
            <span class="kh-project-role">Personal experiment / Concept + Build</span>
            <h3 class="kh-firstlight-wordmark" aria-label="First Light">
              <span class="kh-flight-f">F</span><span class="kh-flight-irst">irst</span>
              <span class="kh-flight-light">LIGHT</span>
            </h3>
            <p class="kh-firstlight-equation" aria-hidden="true">F + LIGHT = FLIGHT</p>
            <p class="kh-mini-project-deck">Five birds, wherever you are, whatever the season.</p>
            <p class="kh-mini-project-description">
              A location-aware dawn chorus that uses recent nearby bird sightings to choose five
              species, then pairs them with real field recordings to build an ambient soundscape for
              that place.
            </p>
            <p class="kh-mini-project-why">
              <strong>Why:</strong> I wanted a dawn chorus that changes with where you are — not a fixed
              playlist pretending every morning sounds the same.
            </p>
          </div>

          <div class="kh-mini-project-footer">
            <div class="kh-mini-tags" aria-label="First Light features">
              <span>LOCATION</span>
              <span>BIRDSONG</span>
              <span>AMBIENT AUDIO</span>
            </div>
            <div class="kh-mini-actions">
              <a class="kh-pill" href={withBase('/works/first-light/')}>See experiment →</a>
              <a
                class="kh-text-link"
                href="https://github.com/iphiginea/FirstLIGHT"
                target="_blank"
                rel="noopener noreferrer">GitHub ↗</a
              >
            </div>
          </div>
        </div>

        <div class="kh-firstlight-visual" aria-hidden="true">
          <div class="kh-firstlight-stars">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
          <p class="kh-firstlight-visual-label">Listening for what’s nearby…</p>
          <div class="kh-firstlight-bird-list">
            <span><i></i>01 / RECENT + LOCAL</span>
            <span><i></i>02 / RECENT + LOCAL</span>
            <span><i></i>03 / RECENT + LOCAL</span>
            <span><i></i>04 / RECENT + LOCAL</span>
            <span><i></i>05 / RECENT + LOCAL</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="kh-system section" aria-labelledby="what-i-do">
    <div class="kh-section-head kh-section-head-ui">
      <div>
        <p class="kh-kicker">02 / WHAT I DO</p>
        <h2 id="what-i-do">Media, strategy, systems, people.</h2>
      </div>
    </div>

    <div class="kh-system-list">
      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">01</span>
          <div>
            <span class="kh-card-label">MEDIA</span>
            <h3>Media investment + strategy</h3>
          </div>
        </div>
        <div class="kh-system-copy">
          <p>
            Turning audience, market, and investment complexity into clear decisions, then leading
            teams through execution.
          </p>
          <div class="kh-system-tags" aria-label="Media capabilities">
            <span>INVESTMENT</span>
            <span>STRATEGY</span>
            <span>TEAM LEADERSHIP</span>
          </div>
        </div>
        <span class="kh-system-arrow" aria-hidden="true">→</span>
      </article>

      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">02</span>
          <div>
            <span class="kh-card-label">AI + SYSTEMS</span>
            <h3>Workflow + systems design</h3>
          </div>
        </div>
        <div class="kh-system-copy">
          <p>
            Finding repeatable friction, mapping the decision logic underneath it, and building
            tools that remove unnecessary work.
          </p>
          <div class="kh-system-tags" aria-label="AI and systems capabilities">
            <span>WORKFLOW DESIGN</span>
            <span>AUTOMATION</span>
            <span>DECISION TOOLS</span>
          </div>
        </div>
        <span class="kh-system-arrow" aria-hidden="true">→</span>
      </article>

      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">03</span>
          <div>
            <span class="kh-card-label">PROBLEM SOLVING</span>
            <h3>Prototyping + experimentation</h3>
          </div>
        </div>
        <div class="kh-system-copy">
          <p>
            Using prototypes and small experiments to test an idea, clarify a workflow, or answer a
            question that is easier to understand once it is tangible.
          </p>
          <div class="kh-system-tags" aria-label="Problem-solving capabilities">
            <span>PROBLEM SOLVING</span>
            <span>PROTOTYPING</span>
            <span>EXPERIMENTATION</span>
          </div>
        </div>
        <span class="kh-system-arrow" aria-hidden="true">→</span>
      </article>

      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">04</span>
          <div>
            <span class="kh-card-label">LEADERSHIP + COMMUNITY</span>
            <h3>Teams + programming</h3>
          </div>
        </div>
        <div class="kh-system-copy">
          <p>
            Leading people, developing talent, teaching what I know, and creating programs that give
            an industry a reason to show up for one another.
          </p>
          <div class="kh-system-tags" aria-label="Leadership and community capabilities">
            <span>PEOPLE LEADERSHIP</span>
            <span>MENTORSHIP</span>
            <span>PROGRAMMING</span>
          </div>
        </div>
        <span class="kh-system-arrow" aria-hidden="true">→</span>
      </article>
    </div>

    <div class="kh-system-footer">
      <a class="kh-text-link" href={withBase('/about/')}>More about how I work →</a>
    </div>
  </section>

  <section class="kh-recognition section" aria-labelledby="recognition">
    <div class="kh-section-head kh-section-head-ui">
      <div>
        <p class="kh-kicker">03 / RECOGNITION + LEADERSHIP</p>
        <h2 id="recognition">A few things worth noting.</h2>
      </div>
    </div>

    <div class="kh-recognition-editorial">
      <article class="kh-recognition-row">
        <div class="kh-recognition-meta">
          <span>RECOGNITION</span>
          <strong>TVB</strong>
          <span>2025</span>
        </div>
        <div class="kh-recognition-copy">
          <h3>Executive NEXT Buyer Honoree</h3>
          <p>Recognition for my work in media investment and buying.</p>
        </div>
      </article>

      <article class="kh-recognition-row">
        <div class="kh-recognition-meta">
          <span>RECOGNITION</span>
          <strong>PMX / PUBLICIS MEDIA</strong>
        </div>
        <div class="kh-recognition-copy">
          <h3>Investment Credo Award</h3>
          <p>
            Internal recognition for leadership, mentorship, and contributions across Investment.
          </p>
        </div>
      </article>

      <article class="kh-recognition-row kh-recognition-row-leadership">
        <div class="kh-recognition-meta">
          <span>LEADERSHIP</span>
          <strong>MEDIA ADVERTISING CLUB OF CHICAGO</strong>
          <span>2025–26</span>
        </div>
        <div class="kh-recognition-copy">
          <h3>President</h3>
          <p>
            Leading industry programming, member engagement, and community-building in Chicago media
            through Chicago's legacy advertising club.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="kh-about section" aria-labelledby="about">
    <div class="kh-about-shell">
      <div class="kh-about-heading">
        <p class="kh-kicker">04 / ABOUT</p>
        <h2 id="about">I like the point where strategy turns into something useful.</h2>
      </div>

      <div class="kh-about-body">
        <p class="kh-about-lead">
          I’m a Chicago-based media leader working across investment, strategy, operations, AI, and
          the systems that help people make better decisions.
        </p>
        <p>
          My work usually starts with friction: a process that is harder than it needs to be, a
          decision that could be clearer, or a system that people have learned to work around. I
          like finding the structure underneath the problem and making the next step easier to
          understand.
        </p>
        <p>
          Outside of my work, I’m usually following some curiosity about music, media, or culture,
          and every so often that curiosity turns into a small experiment of its own.
        </p>

        <dl class="kh-about-notes">
          <div>
            <dt>Based</dt>
            <dd>Chicago, IL</dd>
          </div>
          <div>
            <dt>Working across</dt>
            <dd>Media / Strategy / AI</dd>
          </div>
          <div>
            <dt>Always circling</dt>
            <dd>Movies / Music / Culture</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="kh-contact section">
    <p class="kh-kicker">05 / SAY HELLO</p>
    <h2>Good ideas welcome.</h2>
    <p>Have an interesting problem, idea, or conversation? I’m always happy to talk.</p>
    <div class="kh-contact-row">
      <a class="kh-pill" href="mailto:kiah.harpool@gmail.com">Email me</a>
      <a
        class="kh-text-link"
        href="https://github.com/iphiginea"
        target="_blank"
        rel="noopener noreferrer">GitHub ↗</a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .kh-more-projects {
    margin-top: clamp(2.5rem, 5vw, 5rem);
  }

  .kh-more-projects-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.2rem;
    margin-bottom: 1.25rem;
    border-top: 1px solid rgba(90, 31, 79, 0.24);
  }

  .kh-more-projects-head p {
    margin: 0;
  }

  .kh-more-projects-head > p:last-child {
    color: #5a1f4f;
    font-size: 0.95rem;
    opacity: 0.72;
  }

  .kh-project-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .kh-mini-project {
    min-width: 0;
    min-height: 31rem;
    padding: clamp(1.4rem, 2.5vw, 2.25rem);
    border: 2px solid #5a1f4f;
    border-radius: 22px;
    color: #5a1f4f;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .kh-mini-project-dueldraw {
    background: #d7caf5;
  }

  .kh-mini-project-points {
    background: #f7e8ea;
  }

  .kh-mini-project-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .kh-mini-project-topline span:last-child {
    max-width: 16rem;
    text-align: right;
    opacity: 0.66;
  }

  .kh-mini-project-body h3 {
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6vw, 6.4rem);
    font-style: italic;
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.84;
  }

  .kh-mini-project-deck {
    max-width: 22ch;
    margin: 1.1rem 0 0;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .kh-mini-project-description,
  .kh-mini-project-why {
    max-width: 38rem;
    margin: 1rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .kh-mini-project-why {
    opacity: 0.76;
  }

  .kh-mini-project-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .kh-mini-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .kh-mini-tags span {
    padding: 0.38rem 0.58rem;
    border: 1px solid rgba(90, 31, 79, 0.34);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.055em;
  }

  .kh-mini-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .kh-recognition-editorial {
    border-top: 1px solid rgba(90, 31, 79, 0.22);
  }

  .kh-recognition-row {
    display: grid;
    grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(2.2rem, 4.5vw, 4.25rem) 0;
    border-bottom: 1px solid rgba(90, 31, 79, 0.22);
  }

  .kh-recognition-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    color: #5a1f4f;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .kh-recognition-meta > span:first-child {
    color: #a23d3d;
