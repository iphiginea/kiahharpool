---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { withBase } from '../lib/url';
import { SITE } from '../consts';

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <section class="kh-hero section">
    <div class="kh-meta-row">
      <span>CHICAGO, IL</span>
      <span>MEDIA / TECHNOLOGY / PRODUCTS / CULTURE</span>
    </div>

    <h1 class="kh-name"><span>KIAH</span><span>HARPOOL</span></h1>

    <div class="kh-hero-bottom">
      <div class="kh-hero-intro">
        <p class="kh-deck">I make things work better.</p>
        <p class="kh-hero-positioning">
          Media leader + builder working across strategy, AI, products, and culture.
        </p>
        <a class="kh-pill kh-pill-secondary kh-hero-cta" href="#selected-work">See my work →</a>
      </div>

      <aside class="kh-theme-preview kh-current-card" aria-label="Current focus">
        <div class="kh-theme-preview-head">
          <span>Currently</span>
          <span>→</span>
        </div>
        <p>Leading media strategy and building tools that make complicated work clearer.</p>
        <dl class="kh-current-meta">
          <div>
            <dt>Building</dt>
            <dd>Duel Cut / Encore</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>AI workflows / product experiments</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="kh-work section" aria-labelledby="selected-work">
    <div class="kh-section-head kh-section-head-ui">
      <div>
        <p class="kh-kicker">01 / SELECTED WORK</p>
        <h2 id="selected-work">Things I thought should exist.</h2>
      </div>
      <a class="kh-pill" href={withBase('/works/')}>All work →</a>
    </div>

    <article class="kh-project kh-project-lavender">
      <div class="kh-project-copy">
        <div class="kh-project-topline">
          <span>01 / DUEL CUT</span>
          <span>PRODUCT / FILM / PERSONAL DATA</span>
        </div>
        <span class="kh-project-role">Concept / Product Design / Development</span>
        <h3><a class="kh-project-title-link" href={withBase('/works/duel-cut/')}>DUEL CUT</a></h3>
        <p class="kh-project-deck">Your movie taste, directed by choices instead of star ratings.</p>
        <p class="kh-project-description">
          I built a head-to-head ranking system that turns repeated choices into a personal movie
          canon, then surfaces rankings and taste patterns from those decisions.
        </p>
        <div class="kh-project-why">
          <strong>Why I made it</strong>
          <p>
            Choosing between two movies I love tells me more than giving both of them four stars.
            I wanted a ranking system that behaves more like taste actually does.
          </p>
        </div>
        <div class="kh-chip-row" aria-label="Duel Cut features">
          <span>DUELS</span>
          <span>RANKINGS</span>
          <span>INSIGHTS</span>
        </div>
        <div class="kh-project-actions">
          <a class="kh-pill" href="https://iphiginea.github.io/duelcut/" target="_blank" rel="noopener noreferrer">
            Open app ↗
          </a>
          <a class="kh-text-link" href="https://github.com/iphiginea/duelcut" target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
        </div>
      </div>

      <div class="kh-product-visual kh-product-visual-duelcut">
        <figure class="kh-product-shot kh-product-shot-single">
          <a href={withBase('/works/duel-cut/')} aria-label="Read the Duel Cut case study">
            <img
              src={withBase('/images/duelcut-duel-hd.webp')}
              alt="Duel Cut interface showing a movie duel between Bugonia and Harold and Maude"
              width="600"
              height="959"
              loading="lazy"
            />
          </a>
        </figure>
      </div>
    </article>

    <article class="kh-project kh-project-blush">
      <div class="kh-project-copy">
        <div class="kh-project-topline">
          <span>02 / ENCORE</span>
          <span>PRODUCT / MUSIC / PERSONAL DATA</span>
        </div>
        <span class="kh-project-role">Concept / Product Design / Development</span>
        <h3><a class="kh-project-title-link" href={withBase('/works/encore/')}>ENCORE</a></h3>
        <p class="kh-project-deck">Every concert you have seen. Head to head.</p>
        <p class="kh-project-description">
          I built a concert diary and ranking system around pairwise duels, ticket-like memories,
          ranked shows, and personal statistics.
        </p>
        <div class="kh-project-why">
          <strong>Why I made it</strong>
          <p>
            I kept coming back to an impossible question: what was the best concert I had ever
            seen? Comparing two nights at a time felt more honest than trying to score a lifetime
            of shows.
          </p>
        </div>
        <div class="kh-chip-row" aria-label="Encore features">
          <span>SHOWS</span>
          <span>DUELS</span>
          <span>RANKINGS</span>
        </div>
        <div class="kh-project-actions">
          <a class="kh-pill" href="https://iphiginea.github.io/encore/" target="_blank" rel="noopener noreferrer">
            Open app ↗
          </a>
          <a class="kh-text-link" href="https://github.com/iphiginea/encore" target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
        </div>
      </div>

      <div class="kh-product-visual kh-product-visual-encore">
        <figure class="kh-product-shot kh-product-shot-primary">
          <a href={withBase('/works/encore/')} aria-label="Read the Encore case study">
            <img
              src={withBase('/images/encore-duel-hd.webp')}
              alt="Encore interface showing a concert duel between Joanna Newsom and Kendrick Lamar"
              width="600"
              height="843"
              loading="lazy"
            />
          </a>
        </figure>
        <figure class="kh-product-shot kh-product-shot-secondary">
          <a href={withBase('/works/encore/')} aria-label="Read the Encore case study">
            <img
              src={withBase('/images/encore-rankings-hd.webp')}
              alt="Encore rankings interface showing ranked concerts"
              width="600"
              height="1035"
              loading="lazy"
            />
          </a>
        </figure>
      </div>
    </article>
  </section>

  <section class="kh-system section" aria-labelledby="what-i-do">
    <div class="kh-section-head kh-section-head-ui">
      <div>
        <p class="kh-kicker">02 / WHAT I DO</p>
        <h2 id="what-i-do">A working system, not a job title.</h2>
      </div>
    </div>

    <div class="kh-system-list">
      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">01</span>
          <div>
            <span class="kh-card-label">MEDIA</span>
            <h3>Investment + strategy</h3>
          </div>
        </div>
        <p>Turning complicated media decisions into plans people can actually use.</p>
        <span class="kh-system-arrow">→</span>
      </article>

      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">02</span>
          <div>
            <span class="kh-card-label">AI + SYSTEMS</span>
            <h3>Better ways of working</h3>
          </div>
        </div>
        <p>Finding repeatable friction, then designing workflows that remove it.</p>
        <span class="kh-system-arrow">→</span>
      </article>

      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">03</span>
          <div>
            <span class="kh-card-label">PRODUCT</span>
            <h3>Things that should exist</h3>
          </div>
        </div>
        <p>Small ideas, prototypes, and personal tools that become real products.</p>
        <span class="kh-system-arrow">→</span>
      </article>

      <article>
        <div class="kh-system-main">
          <span class="kh-system-number">04</span>
          <div>
            <span class="kh-card-label">COMMUNITY</span>
            <h3>Leadership + programming</h3>
          </div>
        </div>
        <p>Building teams, teaching, and creating reasons for an industry to gather.</p>
        <span class="kh-system-arrow">→</span>
      </article>
    </div>
  </section>

  <section class="kh-recognition section" aria-labelledby="recognition">
    <div class="kh-section-head kh-section-head-ui">
      <div>
        <p class="kh-kicker">03 / RECOGNITION + LEADERSHIP</p>
        <h2 id="recognition">Selected signals.</h2>
      </div>
    </div>

    <div class="kh-recognition-grid">
      <article>
        <span class="kh-card-label">TVB</span>
        <h3>Executive NEXT Buyer Honoree</h3>
        <span class="kh-arrow">→</span>
      </article>
      <article>
        <span class="kh-card-label">PMX</span>
        <h3>Investment Credo Award</h3>
        <span class="kh-arrow">→</span>
      </article>
      <article>
        <span class="kh-card-label">MAC</span>
        <h3>President, Media Advertising Club of Chicago</h3>
        <span class="kh-arrow">→</span>
      </article>
    </div>
  </section>

  <section class="kh-lab section">
    <p class="kh-kicker">04 / THE LAB</p>
    <div class="kh-lab-grid">
      <h2>Things I’m making because I think they should exist.</h2>
      <div>
        <p>
          Product experiments, AI workflows, ranking systems, media tools, and small ideas that
          get more interesting once they are real.
        </p>
        <a class="kh-pill" href={withBase('/works/')}>Enter the lab →</a>
      </div>
    </div>
  </section>

  <section class="kh-contact section">
    <p class="kh-kicker">05 / SAY HELLO</p>
    <h2>Good ideas welcome.</h2>
    <div class="kh-contact-row">
      <a class="kh-pill" href="mailto:kiah.harpool@gmail.com">Email me</a>
      <a class="kh-text-link" href="https://github.com/iphiginea" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </section>
</BaseLayout>
