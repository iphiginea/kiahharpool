---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import '../styles/kiah.css';
import '../styles/palette.css';
import '../styles/product-alignment.css';
import '../styles/design-system.css';
import '../styles/projects.css';
import '../styles/what-i-do.css';
import '../styles/responsive-pass.css';
import '../styles/first-light.css';
import '../styles/duel-draw.css';
import '../styles/points.css';
import '../styles/encore.css';
import '../styles/duel-cut.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { SITE, NAV_ITEMS } from '../consts';
import { locale, navLabel, t } from '../i18n';
import CodeCopy from '../components/CodeCopy.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const siteName = SITE.title;
const { title = siteName, description = SITE.description, ogType = 'website', image } = Astro.props;
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body id="top">
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label={t('nav.brandHome', { site: siteName })}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>{siteName}</span>
      </a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          NAV_ITEMS.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {navLabel(item)}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-signature">{SITE.footerText}</p>
      <nav class="footer-links" aria-label="Footer">
        <a href={withBase('/works/')}>Work</a>
        <a href="mailto:kiah.harpool@gmail.com">Email</a>
        <a href="https://github.com/iphiginea" target="_blank" rel="noopener noreferrer">GitHub ↗</a
        >
        <a href="#top">Back to top ↑</a>
      </nav>
    </footer>

    <CodeCopy />

    <style is:global>
      .kh-home-thread {
        margin-top: clamp(2.5rem, 6vw, 5.5rem);
        padding: clamp(2rem, 4vw, 3.5rem) 0;
        border-top: 1px solid rgba(90, 31, 79, 0.25);
        border-bottom: 1px solid rgba(90, 31, 79, 0.25);
        color: #5a1f4f;
      }

      .kh-home-thread p {
        max-width: 18ch;
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(2.6rem, 6vw, 6.5rem);
        font-style: italic;
        font-weight: 900;
        letter-spacing: -0.055em;
        line-height: 0.9;
      }

      .kh-about-body .kh-home-about-link {
        display: inline-block;
        margin-top: 0.6rem;
      }
    </style>

    <script>
      const screenshotFallbacks = new Map([
        ['duelcut-duel-hd.webp', 'duelcut-duel.webp'],
        ['encore-duel-hd.webp', 'encore-duel.webp'],
        ['encore-rankings-hd.webp', 'encore-rankings.webp'],
      ]);

      const arrangeHomepage = () => {
        const professionalSection = document.querySelector('.kh-system');
        const experimentsSection = document.querySelector('.kh-work');

        if (
          professionalSection instanceof HTMLElement &&
          experimentsSection instanceof HTMLElement &&
          professionalSection.parentElement === experimentsSection.parentElement
        ) {
          experimentsSection.parentElement?.insertBefore(professionalSection, experimentsSection);

          const professionalKicker = professionalSection.querySelector('.kh-kicker');
          const experimentsKicker = experimentsSection.querySelector('.kh-kicker');
          const heroCta = document.querySelector('.kh-hero-cta');

          if (professionalKicker) professionalKicker.textContent = '01 / WHAT I DO';
          if (experimentsKicker) experimentsKicker.textContent = '02 / PERSONAL EXPERIMENTS';
          if (heroCta instanceof HTMLAnchorElement) heroCta.href = '#what-i-do';
        }
      };

      const enhanceHomepageThread = () => {
        const hero = document.querySelector('.kh-hero');
        const professionalSection = document.querySelector('.kh-system');
        const aboutSection = document.querySelector('.kh-about');

        if (
          !(hero instanceof HTMLElement) ||
          !(professionalSection instanceof HTMLElement) ||
          !(aboutSection instanceof HTMLElement)
        )
          return;

        const heroPositioning = hero.querySelector('.kh-hero-positioning');
        if (heroPositioning instanceof HTMLParagraphElement) {
          heroPositioning.textContent =
            'I work across media, strategy, and technology, making hidden logic visible and complicated systems easier to navigate.';
        }

        const currentCard = hero.querySelector('.kh-current-card');
        if (currentCard instanceof HTMLElement) {
          const currentCopy = currentCard.querySelector(':scope > p');
          if (currentCopy instanceof HTMLParagraphElement) {
            currentCopy.textContent =
              'Turning unwritten rules, complicated decisions, and repeatable friction into clearer systems people can actually use.';
          }

          const currentMeta = currentCard.querySelectorAll('.kh-current-meta dd');
          if (currentMeta[0]) currentMeta[0].textContent = 'Media investment / leadership / systems';
          if (currentMeta[1])
            currentMeta[1].textContent = 'Making the implicit explicit / personal experiments';
        }

        const systemArticles = Array.from(professionalSection.querySelectorAll('.kh-system-list article'));
        const systemsArticle = systemArticles.find(
          (article) => article.querySelector('.kh-card-label')?.textContent?.trim() === 'AI + SYSTEMS',
        );
        const systemsCopy = systemsArticle?.querySelector('.kh-system-copy > p');
        if (systemsCopy instanceof HTMLParagraphElement) {
          systemsCopy.textContent =
            'I tend to notice the parts of a system everyone else has learned to work around. I make the rules visible, map the decision logic, and build something easier to use.';
        }

        if (!professionalSection.querySelector('.kh-home-thread')) {
          const thread = document.createElement('aside');
          thread.className = 'kh-home-thread';
          thread.setAttribute('aria-label', 'A note on clear systems');

          const threadCopy = document.createElement('p');
          threadCopy.textContent = 'Clear systems should not require intuition.';
          thread.appendChild(threadCopy);

          const systemFooter = professionalSection.querySelector('.kh-system-footer');
          professionalSection.insertBefore(thread, systemFooter ?? null);
        }

        const aboutHeading = aboutSection.querySelector('.kh-about-heading h2');
        if (aboutHeading instanceof HTMLHeadingElement) {
          aboutHeading.textContent =
            'I like making a neurotypical world more legible to a neurodivergent brain.';
        }

        const aboutBody = aboutSection.querySelector('.kh-about-body');
        if (aboutBody instanceof HTMLElement && aboutBody.dataset.threadEnhanced !== 'true') {
          aboutBody.querySelectorAll(':scope > p').forEach((paragraph) => paragraph.remove());

          const aboutCopy = document.createElement('p');
          aboutCopy.className = 'kh-about-lead';
          aboutCopy.textContent =
            'A lot of how I work comes from needing to understand the rules beneath a system. What does it expect? Where does it break? What has everyone else simply learned to work around? That instinct shows up in my media work, my approach to AI and workflows, and the little experiments I build for myself.';

          const notes = aboutBody.querySelector('.kh-about-notes');
          aboutBody.insertBefore(aboutCopy, notes ?? null);

          const sourceLink = professionalSection.querySelector('.kh-system-footer a');
          if (sourceLink instanceof HTMLAnchorElement) {
            const aboutLink = sourceLink.cloneNode(true);
            if (aboutLink instanceof HTMLAnchorElement) {
              aboutLink.classList.add('kh-home-about-link');
              aboutBody.insertBefore(aboutLink, notes ?? null);
            }
          }

          aboutBody.dataset.threadEnhanced = 'true';
        }

        const contact = document.querySelector('.kh-contact');
        if (contact instanceof HTMLElement) contact.hidden = true;
        document.body.classList.remove('has-contact-finale');
      };

      const enhanceWorksIndex = () => {
        const workIndexHead = document.querySelector('.kh-work-index-head');
        if (!(workIndexHead instanceof HTMLElement)) return;

        const intro = workIndexHead.querySelector(':scope > p:last-child');
        if (intro instanceof HTMLParagraphElement) {
          intro.textContent =
            'Small experiments that usually start with friction, curiosity, or a question I cannot stop trying to answer. I build them to make something fuzzy, subjective, or complicated a little more legible.';
        }
      };

      const enhanceRecognition = () => {
        const recognition = document.querySelector('.kh-recognition-editorial');
        if (!(recognition instanceof HTMLElement) || recognition.dataset.tvbEnhanced === 'true')
          return;

        const firstRow = recognition.querySelector('.kh-recognition-row');
        if (!(firstRow instanceof HTMLElement)) return;

        const heading = firstRow.querySelector('.kh-recognition-copy h3');
        const description = firstRow.querySelector('.kh-recognition-copy p');

        if (heading instanceof HTMLHeadingElement) {
          const link = document.createElement('a');
          link.href = 'https://www.tvb.org/events/executive-summit/';
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = 'TVB NEXT Media Buyer Honoree';
          link.style.color = 'inherit';
          link.style.textDecoration = 'none';
          heading.replaceChildren(link);
        }

        if (description instanceof HTMLParagraphElement) {
          description.textContent =
            'Recognized as the next generation of leadership in advertising sales, buying, planning, and operations in the media industry.';
        }

        const leadershipRow = recognition.querySelector('.kh-recognition-row-leadership');
        const clubName = leadershipRow?.querySelector('.kh-recognition-meta strong');
        if (clubName instanceof HTMLElement) {
          const link = document.createElement('a');
          link.href = 'https://www.macchicago.com';
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = 'MEDIA ADVERTISING CLUB OF CHICAGO';
          link.style.color = 'inherit';
          link.style.textDecoration = 'none';
          clubName.replaceChildren(link);
        }

        recognition.dataset.tvbEnhanced = 'true';
      };

      const normalizeVisibleCopy = () => {
        const root = document.querySelector('main');
        if (!(root instanceof HTMLElement)) return;

        const replacements: Array<[string, string]> = [
          ['head-to-head', 'head to head'],
          ['two-player', 'two player'],
          ['sketch-and-guess', 'sketch and guess'],
          ['real-time', 'real time'],
          ['body-point-based', 'body point based'],
          ['self-hypnosis', 'self hypnosis'],
          ['at-home', 'at home'],
          ['location-aware', 'location aware'],
          ['five-bird', 'five bird'],
          ['repertory-cinema', 'repertory cinema'],
          ['poster-led', 'poster led'],
          ['five-star', 'five star'],
          ['ticket-like', 'ticket like'],
          ['point-by-point', 'point by point'],
          ['ritual-driven', 'ritual driven'],
          ['community-building', 'community building'],
          ['2025–26', '2025 / 2026'],
          [' — ', ', '],
        ];

        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        let node = walker.nextNode();
        while (node) {
          let value = node.textContent ?? '';
          for (const [from, to] of replacements) value = value.replaceAll(from, to);
          if (node.textContent !== value) node.textContent = value;
          node = walker.nextNode();
        }
      };

      const enhanceSite = () => {
        arrangeHomepage();
        enhanceHomepageThread();
        enhanceWorksIndex();
        enhanceRecognition();
        normalizeVisibleCopy();
      };

      document.addEventListener('astro:page-load', enhanceSite);
      enhanceSite();

      document.addEventListener(
        'error',
        (event) => {
          const image = event.target;
          if (!(image instanceof HTMLImageElement) || image.dataset.fallbackApplied === 'true')
            return;

          const failedName = image.currentSrc.split('/').pop();
          if (!failedName) return;

          const fallbackName = screenshotFallbacks.get(failedName);
          if (!fallbackName) return;

          image.dataset.fallbackApplied = 'true';
          image.src = image.src.replace(failedName, fallbackName);
        },
        true,
      );
    </script>
  </body>
</html>
