---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import '../styles/kiah.css';
import '../styles/palette.css';
import '../styles/product-alignment.css';
import '../styles/design-system.css';
import '../styles/projects.css';
import '../styles/what-i-do.css';
import '../styles/contact-finale.css';
import '../styles/responsive-pass.css';
import '../styles/first-light.css';
import '../styles/duel-draw.css';
import '../styles/points.css';
import '../styles/encore.css';
import '../styles/duel-cut.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { SITE, NAV_ITEMS } from '../consts';
import { locale, navLabel, t } from '../i18n';
import CodeCopy from '../components/CodeCopy.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const siteName = SITE.title;
const { title = siteName, description = SITE.description, ogType = 'website', image } = Astro.props;
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body id="top">
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label={t('nav.brandHome', { site: siteName })}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>{siteName}</span>
      </a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          NAV_ITEMS.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {navLabel(item)}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-signature">{SITE.footerText}</p>
      <nav class="footer-links" aria-label="Footer">
        <a href={withBase('/works/')}>Work</a>
        <a href="mailto:kiah.harpool@gmail.com">Email</a>
        <a href="https://github.com/iphiginea" target="_blank" rel="noopener noreferrer">GitHub ↗</a
        >
        <a href="#top">Back to top ↑</a>
      </nav>
    </footer>

    <CodeCopy />

    <script>
      const screenshotFallbacks = new Map([
        ['duelcut-duel-hd.webp', 'duelcut-duel.webp'],
        ['encore-duel-hd.webp', 'encore-duel.webp'],
        ['encore-rankings-hd.webp', 'encore-rankings.webp'],
      ]);

      const arrangeHomepage = () => {
        const professionalSection = document.querySelector('.kh-system');
        const experimentsSection = document.querySelector('.kh-work');

        if (
          professionalSection instanceof HTMLElement &&
          experimentsSection instanceof HTMLElement &&
          professionalSection.parentElement === experimentsSection.parentElement
        ) {
          experimentsSection.parentElement?.insertBefore(professionalSection, experimentsSection);

          const professionalKicker = professionalSection.querySelector('.kh-kicker');
          const experimentsKicker = experimentsSection.querySelector('.kh-kicker');
          const heroCta = document.querySelector('.kh-hero-cta');

          if (professionalKicker) professionalKicker.textContent = '01 / WHAT I DO';
          if (experimentsKicker) experimentsKicker.textContent = '02 / PERSONAL EXPERIMENTS';
          if (heroCta instanceof HTMLAnchorElement) heroCta.href = '#what-i-do';
        }
      };

      const enhanceContactFinale = () => {
        const contact = document.querySelector('.kh-contact');
        document.body.classList.toggle('has-contact-finale', contact instanceof HTMLElement);

        if (!(contact instanceof HTMLElement) || contact.dataset.finaleEnhanced === 'true') return;

        const heading = contact.querySelector('h2');
        const actions = contact.querySelector('.kh-contact-row');
        const body = Array.from(contact.children).find(
          (element) =>
            element instanceof HTMLParagraphElement && !element.classList.contains('kh-kicker'),
        );

        if (
          !(heading instanceof HTMLHeadingElement) ||
          !(actions instanceof HTMLElement) ||
          !(body instanceof HTMLParagraphElement)
        )
          return;

        heading.textContent = 'Let’s talk';
        body.textContent =
          'Media, workflows, automation, industry ideas, little questions — if there’s something worth figuring out, I’m your girl.';
        body.classList.add('kh-contact-lead');

        const emailLink = actions.querySelector('a[href^="mailto:"]');
        if (emailLink) emailLink.textContent = 'Email me →';

        const finale = document.createElement('div');
        finale.className = 'kh-contact-finale';

        const details = document.createElement('div');
        details.className = 'kh-contact-details';

        heading.insertAdjacentElement('beforebegin', finale);
        finale.appendChild(heading);
        details.appendChild(body);
        details.appendChild(actions);
        finale.appendChild(details);

        const signoff = document.createElement('div');
        signoff.className = 'kh-contact-signoff';
        signoff.setAttribute('aria-label', 'Kiah Harpool, Chicago, 2026');
        signoff.innerHTML = '<span>KIAH HARPOOL</span><span>CHICAGO</span><span>2026</span>';
        contact.appendChild(signoff);

        contact.dataset.finaleEnhanced = 'true';
      };

      const enhanceHomepage = () => {
        arrangeHomepage();
        enhanceContactFinale();
      };

      document.addEventListener('astro:page-load', enhanceHomepage);
      enhanceHomepage();

      document.addEventListener(
        'error',
        (event) => {
          const image = event.target;
          if (!(image instanceof HTMLImageElement) || image.dataset.fallbackApplied === 'true')
            return;

          const failedName = image.currentSrc.split('/').pop();
          if (!failedName) return;

          const fallbackName = screenshotFallbacks.get(failedName);
          if (!fallbackName) return;

          image.dataset.fallbackApplied = 'true';
          image.src = image.src.replace(failedName, fallbackName);
        },
        true,
      );
    </script>
  </body>
</html>
